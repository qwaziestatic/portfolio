---
import "../styles/global.css";
import { site } from "../config";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = site.siteUrl ? new URL(Astro.url.pathname, site.siteUrl).toString() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <div class="profile">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <img src="/portfolio-feature.jpe" alt="" width="72" height="72" />
        </a>
        <h1 id="hero-name" class="profile-name">{site.name}</h1>
        <p class="profile-role">Code, systems, and useful ideas</p>
      </div>
      <nav aria-label="Main">
        <a href="/projects/">Projects</a>
        <a href="/certificates/">Certificates</a>
        <a href="/contact/">Contact</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p>{site.name}, {new Date().getFullYear()}</p>
      <p class="footer-links">
        <a href={site.github}>GitHub</a>
        {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
        <a href={`mailto:${site.email}`}>Email</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1.25rem 1rem;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }

  .brand img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .profile-name {
    margin-top: 0.7rem;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .profile-role {
    margin-top: 0.2rem;
    color: var(--trace);
    font-size: 0.95rem;
    font-weight: 650;
  }

  nav {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
  }

  nav a:hover {
    color: var(--trace);
    background: var(--wash);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 3rem 2.5rem;
    margin-top: 5rem;
    /* A rule that spans the content width only, not the side padding. */
    background: linear-gradient(var(--rule), var(--rule)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  @media (max-width: 420px) {
    .site-header {
      align-items: center;
    }

    .profile {
      align-self: flex-start;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }

    nav a {
      padding-inline: 0.35rem;
      font-size: 0.95rem;
    }
  }
</style>
