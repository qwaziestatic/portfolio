---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="wrap missing">
    <h1>Page not found</h1>
    <p>The address may be mistyped, or the page has moved. <a href="/">Go to the home page</a>.</p>
  </section>
</Base>

<style>
  .missing {
    padding-block: 6rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    font-stretch: 125%;
    margin-bottom: 1rem;
  }
</style>
