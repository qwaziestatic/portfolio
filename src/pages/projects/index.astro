---
import Base from "../../layouts/Base.astro";
import { site } from "../../config";
import { projects } from "../../data/projects";
---

<Base title={`Projects: ${site.name}`} description={`Projects built by ${site.name}.`}>
  <section class="wrap section" aria-labelledby="projects-title">
    <p class="back"><a href="/">Home</a></p>
    <h1 id="projects-title">Projects</h1>
    <ol class="projects" role="list">
      {projects.map((p) => (
        <li class="project">
          <div class="project-main">
            <h2>
              <a href={`/projects/${p.slug}/`}>{p.name}</a>
              {p.nativeName && <span class="native" lang="am">{p.nativeName}</span>}
            </h2>
            <p>{p.summary}</p>
          </div>
          <div class="project-meta">
            <p class="kind">{p.kind}</p>
            <p class="status" data-tone={p.status.tone}>{p.status.label}</p>
          </div>
          <p class="project-stack">{p.stack.join(", ")}</p>
          <div class="project-links">
            {p.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .section { padding-block: 2.5rem 1rem; }
  .back { margin-bottom: 1.25rem; font-size: 0.9375rem; }
  h1 { font-size: clamp(2.5rem, 7vw, 4.75rem); margin-bottom: 2rem; }
  .projects { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .project {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 0.9fr);
    gap: 0.75rem 2rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .project h2 { font-size: clamp(1.35rem, 2.4vw, 1.65rem); margin-bottom: 0.4rem; }
  .project h2 a { color: var(--ink); text-decoration: none; }
  .project h2 a:hover { color: var(--trace); text-decoration: underline; }
  .native { margin-left: 0.6rem; color: var(--muted); font-size: 0.8em; }
  .project-main p { max-width: 52ch; }
  .project-meta { display: flex; flex-direction: column; gap: 0.3rem; padding-top: 0.35rem; }
  .kind { font-weight: 600; font-size: 0.9375rem; }
  .project-stack { padding-top: 0.35rem; color: var(--muted); font-size: 0.9375rem; }
  .project-links { grid-column: 1 / -1; font-size: 0.9375rem; font-weight: 600; }
  @media (max-width: 860px) {
    .project { grid-template-columns: 1fr; }
    .project-meta, .project-stack { padding-top: 0; }
  }
</style>
