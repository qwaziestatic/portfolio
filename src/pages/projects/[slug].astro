---
import Base from "../../layouts/Base.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import { site } from "../../config";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, sheet: i + 2 },
  }));
}

interface Props {
  project: Project;
  sheet: number;
}

const { project: p, sheet } = Astro.props;
const sheets = projects.length + 1;
const index = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(index + 1) % projects.length];
---

<Base title={`${p.name}: ${p.kind} by ${site.name}`} description={p.summary}>
  <article class="wrap">
    <header class="head">
      <div>
        <p class="back"><a href="/projects/">All projects</a></p>
        <h1>
          {p.name}
          {p.nativeName && <span class="native" lang="am">{p.nativeName}</span>}
        </h1>
        <p class="summary">{p.summary}</p>
        <p class="status" data-tone={p.status.tone}>{p.status.label}</p>
        {
          p.links.length > 0 && (
            <p class="links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noreferrer">{l.label}</a>
              ))}
            </p>
          )
        }
      </div>
      <TitleBlock
        rows={[
          { label: "Title", value: p.name, wide: true },
          { label: "Type", value: p.kind, wide: true },
          { label: "Drawn by", value: site.name },
          { label: "Sheet", value: `${sheet} of ${sheets}` },
        ]}
      />
    </header>

    <div class="body">
      <section>
        <h2>The problem</h2>
        <p>{p.problem}</p>
      </section>

      <section>
        <h2>What it does</h2>
        <p>{p.how}</p>
      </section>

      <section>
        <h2>How it was built</h2>
        <div class="decisions">
          {
            p.decisions.map((d) => (
              <div class="decision">
                <h3>{d.title}</h3>
                <p>{d.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="split">
        <div>
          <h2>Built with</h2>
          <ul>
            {p.stack.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <h2>Known limits</h2>
          <ul>
            {p.limits.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </section>
    </div>

    <nav class="next" aria-label="Next project">
      <p>Next project</p>
      <a href={`/projects/${next.slug}/`}>{next.name}</a>
    </nav>
  </article>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem 3rem;
    padding-block: 2.5rem 3rem;
    border-bottom: 1.5px solid var(--ink);
  }

  .back {
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 0.95;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 1rem;
  }

  h1 .native {
    font-size: 0.55em;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }

  .summary {
    max-width: 50ch;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.5;
    margin-block: 1.25rem 1rem;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
    font-weight: 600;
  }

  .body {
    max-width: var(--measure);
  }

  .body > section {
    padding-top: 3rem;
  }

  .body h2 {
    font-size: 1.35rem;
    font-stretch: 112%;
    margin-bottom: 0.75rem;
  }

  .decisions {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.25rem;
  }

  .decision {
    padding-left: 1.1rem;
    border-left: 2px solid var(--trace);
  }

  .decision h3 {
    margin-bottom: 0.35rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  li + li {
    margin-top: 0.3rem;
  }

  .next {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .next p {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .next a {
    font-size: 1.5rem;
    font-weight: 750;
    font-stretch: 112%;
  }

  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
